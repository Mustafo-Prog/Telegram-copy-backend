PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/telegram-clone
JWT_SECRET=замените-на-длинную-случайную-строку
JWT_EXPIRES_IN=30d
CLIENT_ORIGIN=

# Почта (обычный SMTP через nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ваш-адрес@gmail.com
SMTP_PASS=пароль-приложения
MAIL_FROM=ваш-адрес@gmail.com

# Только для локальной разработки: письма не отправляются, код выводится в консоль
# MAIL_MODE=console
