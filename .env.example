PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/telegram-clone
JWT_SECRET=замените-на-длинную-случайную-строку
JWT_EXPIRES_IN=30d
CLIENT_ORIGIN=

# Почта: Brevo HTTP API
BREVO_API_KEY=xkeysib-замените-на-ключ-из-brevo
MAIL_FROM=Telegram Clone <ваш-подтверждённый-адрес@example.com>

# Только для локальной разработки: письма не отправляются, код выводится в консоль
# MAIL_MODE=console
